<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.mdevlopm.Gomceix</id>
  <name>Gomceix</name>
  <summary>Bedrock launcher for GNOME</summary>
  <developer id="io.github.mdevlopm">
    <name>mdevlopm</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>Gomceix is a GNOME-style launcher for Minecraft Bedrock Edition on Linux. It downloads the game from the Microsoft Store with your own account, sets up everything the game needs, and starts it.</p>
    <p>Features:</p>
    <ul>
      <li>Install and manage game versions, accounts, profiles, worlds and content</li>
      <li>Real Xbox sign-in, so friends, servers and Realms work from inside the game</li>
      <li>Light, dark and custom JSON themes, and a picture behind the Play banner</li>
      <li>Requirements page that lists every component Gomceix downloads, each removable on its own</li>
      <li>Diagnostics for your GPU and the game's Wine prefix</li>
      <li>English, Turkish and Chinese interface, switchable at runtime</li>
    </ul>
    <p>Gomceix does not contain or distribute Minecraft. A Minecraft licence linked to your Microsoft account is required. Gomceix is not affiliated with Mojang or Microsoft.</p>
  </description>
  <launchable type="desktop-id">io.github.mdevlopm.Gomceix.desktop</launchable>
  <url type="homepage">https://github.com/mdevlopm/gomceix</url>
  <url type="bugtracker">https://github.com/mdevlopm/gomceix/issues</url>
  <url type="vcs-browser">https://github.com/mdevlopm/gomceix</url>
